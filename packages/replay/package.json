{
  "name": "@epok/replay",
  "version": "0.0.0",
  "description": "Epok replay: executable re-run, snapshot/mock, and validation over Interaction artifacts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@epok/core": "workspace:*"
  },
  "devDependencies": {
    "@epok/storage-memory": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}
