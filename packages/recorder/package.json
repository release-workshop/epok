{
  "name": "@epok/recorder",
  "version": "0.0.0",
  "description": "Epok recorder: Node HTTP attach seam adapting into Fetch-shaped core contracts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
