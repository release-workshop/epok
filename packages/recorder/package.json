{
  "name": "@epok/recorder",
  "version": "0.0.0",
  "description": "Epok recorder: Node HTTP attach seam adapting into Fetch-shaped core contracts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workers": {
      "types": "./dist/workers.d.ts",
      "import": "./dist/workers.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "import": "./dist/bun.js"
    },
    "./deno": {
      "types": "./dist/deno.d.ts",
      "import": "./dist/deno.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "stress:shed": "pnpm run build && node --expose-gc --experimental-strip-types ./harness/stress-shed.ts",
    "credibility:b": "pnpm run build && node --experimental-strip-types ./harness/credibility-b.ts",
    "test:bun": "pnpm run build && bun test ./tests/bun-runtime-native.test.ts"
  },
  "dependencies": {
    "@epok/core": "workspace:*"
  },
  "devDependencies": {
    "@epok/replay": "workspace:*",
    "@epok/storage-memory": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}
